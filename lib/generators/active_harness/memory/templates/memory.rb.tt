class <%= class_name %>Memory < ActiveHarness::Memory
  def initialize(session_id:)
    super(
      session_id:   session_id,
      depth:        10,
      adapter:      :file,
      path:         Rails.root.join("storage", "ai", "memory").to_s,
      storage_size: 200,
      pretty:       Rails.env.development?
    )
  end
end
